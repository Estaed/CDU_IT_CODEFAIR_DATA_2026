.DS_Store
*.bak
*.orig
.env

# Generated per clone by render_codex_hooks.py — carries an absolute, machine-specific
# path, so it must never be committed (in the template or in a project cloned from it).
.codex/hooks.json

# Spike downloads (hundreds of MB, re-fetchable from the URLs in spike/README.md)
spike/raw/
.venv/

# Raw source snapshots (20 MB BushTel detail JSON; re-fetchable with spike/lane_bushtel.py,
# and BushTel reuse terms are still Open Question 1 in docs/PRD.md)
data/raw/

# Regenerable from design/ds/ (see BACKLOG.md 2026-09-12)
design/*.zip

# Build output; dist/index.html is rebuilt by scripts/build_app.py
dist/

# Python and tool caches
__pycache__/
.pytest_cache/
.ruff_cache/

# ACCC KML parse cache written by pipeline/sources/accc.py; rebuilt from data/raw/ when stale
data/out/cache/
