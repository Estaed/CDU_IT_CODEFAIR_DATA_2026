{
  "$schema": "crosscheck-tokens/1.0",
  "color": {
    "primary": "#111111",
    "primary-pressed": "#242424",
    "primary-disabled": "#e5e7eb",
    "ink": "#111111",
    "body": "#374151",
    "muted": "#6b7280",
    "muted-soft": "#898989",
    "hairline": "#e5e7eb",
    "hairline-soft": "#f3f4f6",
    "canvas": "#ffffff",
    "surface-soft": "#f8f9fa",
    "surface-card": "#f5f5f5",
    "surface-strong": "#e5e7eb",
    "on-primary": "#ffffff"
  },
  "verdict": {
    "works":    { "word": "Works",    "glyph": "●", "shape": "circle",   "text": "#157a3a", "fill": "#e6f4ea" },
    "degraded": { "word": "Degraded", "glyph": "▲", "shape": "triangle", "text": "#8a5a00", "fill": "#f6ead0" },
    "fails":    { "word": "Fails",    "glyph": "■", "shape": "square",   "text": "#b42318", "fill": "#fbe4e0" },
    "nodata":   { "word": "No data",  "glyph": "–", "shape": "dash",     "text": "#596270", "fill": "#f3f4f6" }
  },
  "semantic": {
    "text-heading": "{color.ink}",
    "text-body": "{color.body}",
    "text-secondary": "{color.muted}",
    "text-tertiary": "{color.muted-soft}",
    "text-on-primary": "{color.on-primary}",
    "surface-page": "{color.canvas}",
    "surface-block": "{color.surface-card}",
    "surface-soft": "{color.surface-soft}",
    "surface-pressed": "{color.surface-strong}",
    "border-hairline": "{color.hairline}",
    "border-hairline-soft": "{color.hairline-soft}",
    "action-primary": "{color.primary}",
    "action-primary-pressed": "{color.primary-pressed}",
    "action-disabled": "{color.primary-disabled}",
    "link": "{color.ink}",
    "focus-ring": "{color.ink}",
    "tab-selected": "{color.ink}",
    "map-outline": "{color.muted}",
    "map-land": "{color.surface-soft}"
  },
  "font": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "weight": { "regular": 400, "semibold": 600 }
  },
  "type": {
    "title-lg":  { "family": "{font.sans}", "size": "22px", "weight": 600, "lineHeight": 1.3, "letterSpacing": "-0.3px" },
    "title-md":  { "family": "{font.sans}", "size": "18px", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0" },
    "title-sm":  { "family": "{font.sans}", "size": "16px", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0" },
    "body-md":   { "family": "{font.sans}", "size": "16px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "body-sm":   { "family": "{font.sans}", "size": "14px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "caption":   { "family": "{font.sans}", "size": "13px", "weight": 400, "lineHeight": 1.4, "letterSpacing": "0" },
    "label":     { "family": "{font.sans}", "size": "13px", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0" },
    "button":    { "family": "{font.sans}", "size": "14px", "weight": 600, "lineHeight": 1,   "letterSpacing": "0" },
    "tab":       { "family": "{font.sans}", "size": "14px", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0" },
    "figure-lg": { "family": "{font.mono}", "size": "22px", "weight": 400, "lineHeight": 1.3, "letterSpacing": "0" },
    "figure-md": { "family": "{font.mono}", "size": "16px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "figure-sm": { "family": "{font.mono}", "size": "14px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "figure-xs": { "family": "{font.mono}", "size": "13px", "weight": 400, "lineHeight": 1.4, "letterSpacing": "0" }
  },
  "space": { "xxs": "4px", "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "48px" },
  "radius": { "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "pill": "9999px", "full": "9999px" },
  "size": {
    "touch": "44px",
    "control": "44px",
    "topbar": "56px",
    "chip": "28px",
    "badge": "24px",
    "screen-pad": "16px",
    "content-max": "640px",
    "design-width": "360px",
    "viewport-min-height": "640px",
    "hairline": "1px",
    "rule": "3px",
    "focus-ring": "2px",
    "map-point": "10px",
    "map-point-ring": "18px",
    "qr": "200px"
  }
}
