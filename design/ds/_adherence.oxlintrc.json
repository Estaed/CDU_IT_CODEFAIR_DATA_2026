{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/community/**",
              "components/core/**",
              "components/map/**",
              "components/navigation/**",
              "components/search/**",
              "components/services/**",
              "components/share/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgreementHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:covered|total|subject|key|ref|className|style|children)$/]",
        "message": "<AgreementHeadline> doesn't accept that prop. Declared props: covered, total, subject."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssumptionNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|children|label|key|ref|className|style|children)$/]",
        "message": "<AssumptionNote> doesn't accept that prop. Declared props: text, children, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|fullWidth|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, fullWidth, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|selected|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, onClick, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommunityHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|region|type|population|populationSource|populationDate|children|key|ref|className|style|children)$/]",
        "message": "<CommunityHeader> doesn't accept that prop. Declared props: name, region, type, population, populationSource, populationDate, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figures'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|size|key|ref|className|style|children)$/]",
        "message": "<Figures> doesn't accept that prop. Declared props: text, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figures'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<Figures> size must be one of 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<FilterTab> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:attributions|team|statement|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: attributions, team, statement."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:counts|subject|key|ref|className|style|children)$/]",
        "message": "<MapLegend> doesn't accept that prop. Declared props: counts, subject."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapPoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|lon|lat|verdict|key|ref|className|style|children)$/]",
        "message": "<MapPoint> doesn't accept that prop. Declared props: id, name, lon, lat, verdict."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapPoint'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:works|degraded|fails|nodata)$/]",
        "message": "<MapPoint> verdict must be one of 'works' | 'degraded' | 'fails' | 'nodata'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublisherRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:publisher|kind|saysCovered|detail|source|date|key|ref|className|style|children)$/]",
        "message": "<PublisherRow> doesn't accept that prop. Declared props: publisher, kind, saysCovered, detail, source, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublisherRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:predicted|licensed|listed|portal)$/]",
        "message": "<PublisherRow> kind must be one of 'predicted' | 'licensed' | 'listed' | 'portal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PublisherRow'] > JSXAttribute[name.name='saysCovered'] > Literal[value!=/^(?:covered|not-covered|not-recorded)$/]",
        "message": "<PublisherRow> saysCovered must be one of 'covered' | 'not-covered' | 'not-recorded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QrCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|modules|level|size|label|key|ref|className|style|children)$/]",
        "message": "<QrCode> doesn't accept that prop. Declared props: text, modules, level, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='QrCode'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:L|M)$/]",
        "message": "<QrCode> level must be one of 'L' | 'M'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchResult'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|aliases|region|population|key|ref|className|style|children)$/]",
        "message": "<SearchResult> doesn't accept that prop. Declared props: id, name, aliases, region, population."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceSource'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|source|date|key|ref|className|style|children)$/]",
        "message": "<ServiceSource> doesn't accept that prop. Declared props: label, source, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:qrText|qrModules|packDate|packSize|appSize|buildSource|onShare|onSave|shareLabel|saveLabel|statement|key|ref|className|style|children)$/]",
        "message": "<ShareCard> doesn't accept that prop. Declared props: qrText, qrModules, packDate, packSize, appSize, buildSource, onShare, onSave, shareLabel, saveLabel, statement."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|source|date|key|ref|className|style|children)$/]",
        "message": "<SourceLine> doesn't accept that prop. Declared props: label, source, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|offline|sticky|children|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, offline, sticky, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|key|ref|className|style|children)$/]",
        "message": "<VerdictBadge> doesn't accept that prop. Declared props: verdict."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:works|degraded|fails|nodata)$/]",
        "message": "<VerdictBadge> verdict must be one of 'works' | 'degraded' | 'fails' | 'nodata'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
